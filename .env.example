# Example environment variables for ATMS
# Copy to .env and set real values before deployment.
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Africa/Lagos
APP_BASE_URL=https://your-domain.example
SESSION_NAME=ATMS_SESSION
SESSION_TIMEOUT=900

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=automated_tax_management
DB_USER=atms_app
DB_PASS=change-me
DB_CHARSET=utf8mb4
