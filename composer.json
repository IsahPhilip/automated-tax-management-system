{
    "name": "atms/automated-tax-management-system",
    "description": "Automated Tax Management System",
    "type": "project",
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "classmap": [
            "app/"
        ]
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml",
        "deploy:check": "php -l app/helpers/security.php && php -l app/controllers/AuthController.php && php -l public/index.php",
        "deploy:prepare": "composer install --no-interaction --prefer-dist --no-progress --no-scripts"
    },
    "require-dev": {
        "phpunit/phpunit": "10"
    }
}
